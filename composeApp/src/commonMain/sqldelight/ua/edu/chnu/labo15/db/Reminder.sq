-- Table that stores a single reminder.
-- isDone is kept as INTEGER (0/1); SQLDelight maps it to a Kotlin Boolean.
CREATE TABLE Reminder (
    id        INTEGER PRIMARY KEY AUTOINCREMENT,
    title     TEXT    NOT NULL,
    note      TEXT    NOT NULL DEFAULT '',
    isDone    INTEGER AS kotlin.Boolean NOT NULL DEFAULT 0,
    createdAt INTEGER NOT NULL
);

-- Pending reminders first, newest within each group on top.
selectAll:
SELECT *
FROM Reminder
ORDER BY isDone ASC, createdAt DESC;

insert:
INSERT INTO Reminder(title, note, isDone, createdAt)
VALUES (?, ?, ?, ?);

setDone:
UPDATE Reminder
SET isDone = ?
WHERE id = ?;

deleteById:
DELETE FROM Reminder
WHERE id = ?;

deleteAll:
DELETE FROM Reminder;
